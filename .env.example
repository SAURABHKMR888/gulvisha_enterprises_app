# PostgreSQL connection used by the Spring Boot backend
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gulvisha
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Frontend development API target (optional; Vite defaults to localhost:8080)
VITE_API_BASE_URL=/api

# Credentials used only for the protected internal enquiries API
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT settings
JWT_SECRET=change-me-use-a-long-random-secret-key-in-production
JWT_EXPIRATION=86400000